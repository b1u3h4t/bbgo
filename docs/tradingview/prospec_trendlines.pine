//@version=5
// Prospec / Trader Vic style dual trendlines: OLS + RANSAC(combinatorial)
// Paste into TradingView → Pine Editor → Add to chart.
// Compare with: LuxAlgo ML Regression Trend, Metrify Automatic Trendline, Casoon Auto Trendlines.
indicator("Prospec Trendlines OLS+RANSAC", overlay=true, max_lines_count=20, max_labels_count=20)

pivotLen     = input.int(3, "Pivot L/R bars", minval=2, maxval=10)
lookback     = input.int(80, "Pivot lookback bars", minval=30, maxval=300)
minTouches   = input.int(3, "RANSAC min touches", minval=2, maxval=8)
tolATR       = input.float(0.30, "Touch tol × ATR", minval=0.05, step=0.05)
showOLS      = input.bool(true, "Show OLS")
showRANSAC   = input.bool(true, "Show RANSAC")
extendRight  = input.int(20, "Extend bars", minval=0, maxval=100)

ph = ta.pivothigh(high, pivotLen, pivotLen)
pl = ta.pivotlow(low, pivotLen, pivotLen)

var float[] phP = array.new_float()
var int[]   phB = array.new_int()
var float[] plP = array.new_float()
var int[]   plB = array.new_int()

if not na(ph)
    array.push(phP, ph)
    array.push(phB, bar_index - pivotLen)
if not na(pl)
    array.push(plP, pl)
    array.push(plB, bar_index - pivotLen)

// prune old
while array.size(phB) > 0 and array.get(phB, 0) < bar_index - lookback
    array.shift(phP)
    array.shift(phB)
while array.size(plB) > 0 and array.get(plB, 0) < bar_index - lookback
    array.shift(plP)
    array.shift(plB)

f_ols(float[] px, int[] bx) =>
    int n = array.size(px)
    float sx = 0.0, sy = 0.0, sxx = 0.0, sxy = 0.0
    for i = 0 to n - 1
        x = array.get(bx, i)
        y = array.get(px, i)
        sx += x
        sy += y
        sxx += x * x
        sxy += x * y
    float den = n * sxx - sx * sx
    float slope = den == 0 ? 0.0 : (n * sxy - sx * sy) / den
    float icept = (sy - slope * sx) / n
    [slope, icept]

f_score_ok(float slope, bool support) =>
    support ? slope > 0 : slope < 0

f_count_inliers(float[] px, int[] bx, float slope, float icept, float tol) =>
    int touches = 0
    float[] iy = array.new_float()
    int[]   ix = array.new_int()
    for i = 0 to array.size(px) - 1
        x = array.get(bx, i)
        y = array.get(px, i)
        yhat = icept + slope * x
        if math.abs(y - yhat) <= tol
            touches += 1
            array.push(iy, y)
            array.push(ix, x)
    [touches, iy, ix]

f_best_ransac(float[] px, int[] bx, float tol, bool support) =>
    int n = array.size(px)
    float bestScore = -1.0
    float bestS = na
    float bestA = na
    int bestT = 0
    int bestX1 = na
    int bestX2 = na
    float bestY1 = na
    float bestY2 = na
    if n >= 2
        for i = 0 to n - 2
            for j = i + 1 to n - 1
                x1 = array.get(bx, i)
                x2 = array.get(bx, j)
                y1 = array.get(px, i)
                y2 = array.get(px, j)
                dx = x2 - x1
                if dx == 0
                    continue
                slope = (y2 - y1) / dx
                if not f_score_ok(slope, support)
                    continue
                icept = y1 - slope * x1
                [touches, iy, ix] = f_count_inliers(px, bx, slope, icept, tol)
                if touches < minTouches
                    continue
                [s2, a2] = f_ols(iy, ix)
                if not f_score_ok(s2, support)
                    continue
                sc = touches * 3.0
                if sc > bestScore
                    bestScore := sc
                    bestS := s2
                    bestA := a2
                    bestT := touches
                    bestX1 := array.get(ix, 0)
                    bestX2 := array.get(ix, array.size(ix) - 1)
                    bestY1 := a2 + s2 * bestX1
                    bestY2 := a2 + s2 * bestX2
    [bestS, bestA, bestT, bestX1, bestX2, bestY1, bestY2]

var line olsSup = na
var line olsRes = na
var line ranSup = na
var line ranRes = na
var label labOLS = na
var label labRAN = na

if barstate.islast
    line.delete(olsSup)
    line.delete(olsRes)
    line.delete(ranSup)
    line.delete(ranRes)
    label.delete(labOLS)
    label.delete(labRAN)
    tol = ta.atr(14) * tolATR

    if showOLS and array.size(plP) >= 2
        [s, a] = f_ols(plP, plB)
        if f_score_ok(s, true)
            x1 = array.get(plB, 0)
            x2 = array.get(plB, array.size(plB) - 1)
            y1 = a + s * x1
            y2 = a + s * x2
            olsSup := line.new(x1, y1, x2 + extendRight, a + s * (x2 + extendRight), color=color.new(color.teal, 20), width=2, style=line.style_dashed)
    if showOLS and array.size(phP) >= 2
        [s, a] = f_ols(phP, phB)
        if f_score_ok(s, false)
            x1 = array.get(phB, 0)
            x2 = array.get(phB, array.size(phB) - 1)
            olsRes := line.new(x1, a + s * x1, x2 + extendRight, a + s * (x2 + extendRight), color=color.new(color.orange, 20), width=2, style=line.style_dashed)

    if showRANSAC and array.size(plP) >= 2
        [s, a, t, x1, x2, y1, y2] = f_best_ransac(plP, plB, tol, true)
        if not na(s)
            ranSup := line.new(x1, y1, x2 + extendRight, a + s * (x2 + extendRight), color=color.green, width=3)
            labRAN := label.new(x2, y2, "RANSAC support t=" + str.tostring(t), style=label.style_label_up, color=color.new(color.green, 70), textcolor=color.green, size=size.tiny)
    if showRANSAC and array.size(phP) >= 2
        [s, a, t, x1, x2, y1, y2] = f_best_ransac(phP, phB, tol, false)
        if not na(s)
            ranRes := line.new(x1, y1, x2 + extendRight, a + s * (x2 + extendRight), color=color.red, width=3)
            labOLS := label.new(x2, y2, "RANSAC resist t=" + str.tostring(t), style=label.style_label_down, color=color.new(color.red, 70), textcolor=color.red, size=size.tiny)

plotshape(not na(pl), style=shape.triangleup, location=location.belowbar, color=color.new(color.green, 40), size=size.tiny, offset=-pivotLen)
plotshape(not na(ph), style=shape.triangledown, location=location.abovebar, color=color.new(color.red, 40), size=size.tiny, offset=-pivotLen)
